# ==== Mode & Sumber Musik ====
# youtube (default siaran radio) | spotify (remote control mode lama)
MUSIC_SOURCE=youtube
YTDLP_PATH=bin/yt-dlp.exe
YT_AUDIO_FORMAT=opus
YT_AUDIO_BITRATE=128
YT_SEARCH_LIMIT=5
YT_MAX_DURATION_SEC=600
YT_MIN_DURATION_SEC=30
YT_ALLOW_TEXT_SEARCH=true
YT_ALLOW_PLAYLIST=false
YT_BLOCK_LIVE=true
YT_COOKIES_FILE=
YT_PROXY=
CACHE_MAX_GB=10
PREFETCH_COUNT=2

# ==== Broadcast Engine & Stream Output ====
# hls | rtmp | both
STREAM_MODE=hls
STREAM_BITRATE=128k
STREAM_SAMPLE_RATE=44100
STREAM_CHANNELS=2
HLS_SEGMENT_SECONDS=2
HLS_DIR=data/hls
RTMP_URL=
RTMP_KEY=
WEB_PORT=8000
FFMPEG_PATH=bin/ffmpeg.exe

# ==== AI Host (Penyiar Radio AI) ====
HOST_ENABLED=true
HOST_LANGUAGE=id
HOST_PERSONA=Santai, ramah, bersahabat layaknya penyiar radio FM anak muda
HOST_MODE=every_song
HOST_INTERVAL_SONGS=3
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
TTS_ENGINE=piper
PIPER_PATH=bin/piper.exe
PIPER_MODEL=models/id_ID-news-medium.onnx
HOST_MAX_CHARS=400
DUCK_LEVEL=0.25
DUCK_ATTACK_MS=200
DUCK_RELEASE_MS=800

# ==== Interaksi & Moderasi Antrian ====
SHOUTOUT_ENABLED=true
SHOUTOUT_MAX_CHARS=200
REQUEST_COOLDOWN_SEC=30
MAX_QUEUE_PER_USER=3
MAX_QUEUE_TOTAL=20
BANNED_WORDS=judi,slot,porn,bokep
WEB_REQUESTS_OPEN=true
TELEGRAM_ENABLED=true

# ==== Telegram ====
# Token dari @BotFather (contoh: 123456789:AAExampleTokenReplaceMe)
TELEGRAM_BOT_TOKEN=

# Admin (DM). Cuma ID ini yang bisa pakai bot di chat pribadi.
# Cari ID lewat @userinfobot. Pisah pakai koma.
ALLOWED_TELEGRAM_IDS=

# Grup yang diizinkan. KOSONGKAN = semua grup bebas (temen tinggal masuk grup & queue).
# Isi kalau mau batasi cuma grup tertentu. ID grup formatnya negatif, misal -1001234567890.
# Ambil ID grup: masukin bot ke grup, lalu ketik /status (ID chat muncul di log).
ALLOWED_GROUP_IDS=

# ==== Spotify ====
# Buat app di https://developer.spotify.com/dashboard
# Redirect URI HARUS persis sama, contoh: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ==== Device / player ====
# Nama device Spotify Connect (Android di lantai lain). Dicek by nama,
# bukan id, karena id berubah tiap reconnect.
DEVICE_NAME=Lantai 2

# ==== Watchdog & server ====
POLL_INTERVAL_SECONDS=20
HEALTH_PORT=8080
DATA_DIR=/app/data

# Opsional: chat id untuk notif device offline/online.
# Kosongkan untuk kirim ke semua user di ALLOWED_TELEGRAM_IDS.
NOTIFY_CHAT_ID=

# ==== LLM (OpenRouter) ====
# Isi API key untuk mengaktifkan asisten bahasa natural (tool calling).
# Kosong = fitur NLP dimatikan (command /search, /queue, dll tetap jalan).
# Ambil key di https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model gratis (default). 'openrouter/free' = router otomatis ke model gratis
# yang tersedia & mendukung tool calling. Bisa diganti model lain (:free).
OPENROUTER_MODEL=openrouter/free
# Base URL (biasanya tidak perlu diubah).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
